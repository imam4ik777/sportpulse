# 1. Используем стабильную Node-версию
FROM node:18

# 2. Назначаем рабочую директорию
WORKDIR /app

# 3. Устанавливаем зависимости (копируем только то, что нужно сначала — для кеша)
COPY package*.json ./
RUN npm install --production

# 4. Копируем остальные исходники
COPY . .

# 5. Открываем порт (по желанию)
EXPOSE 3001

# 6. Запуск сервера
CMD ["node", "src/app/main.js"]